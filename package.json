{
  "name": "json-schema-to-openai-typescript",
  "version": "0.2.0",
  "description": "Convert JSON Schema into OpenAI's TypeScript-like schema representation for tool schemas, MCP, and standalone structured schemas.",
  "license": "MIT",
  "author": "Serbyte Development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serbyte-development/json-schema-to-openai-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/serbyte-development/json-schema-to-openai-typescript/issues"
  },
  "homepage": "https://github.com/serbyte-development/json-schema-to-openai-typescript#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "json-schema-to-openai-typescript": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "convert": "npm run build --silent && node dist/cli.js",
    "openai:serve": "tsx verify-openai/server.ts",
    "openai:tunnel": "ngrok http 3210",
    "openai:conversion:capture-tools": "tsx verify-openai/check-conversion/capture-tools.ts --write",
    "openai:conversion:capture-tools:check": "tsx verify-openai/check-conversion/capture-tools.ts --check",
    "openai:conversion:normalize": "tsx verify-openai/check-conversion/normalize-signatures.ts --write",
    "openai:conversion:normalize:check": "tsx verify-openai/check-conversion/normalize-signatures.ts --check",
    "openai:conversion:support-matrix": "tsx verify-openai/check-conversion/generate-support-matrix.ts --write",
    "openai:conversion:support-matrix:check": "tsx verify-openai/check-conversion/generate-support-matrix.ts --check",
    "openai:conversion:finalize": "npm run openai:conversion:normalize && npm run openai:conversion:support-matrix",
    "openai:conversion:verify": "npm run openai:conversion:capture-tools:check && npm run openai:conversion:normalize:check && npm run openai:conversion:support-matrix:check",
    "openai:ingestion:inspect": "tsx verify-openai/check-ingestion/inspect.ts --write",
    "openai:ingestion:inspect:check": "tsx verify-openai/check-ingestion/inspect.ts --check",
    "openai:ingestion:normalize": "tsx verify-openai/check-ingestion/normalize-signatures.ts --write",
    "openai:ingestion:normalize:check": "tsx verify-openai/check-ingestion/normalize-signatures.ts --check",
    "openai:ingestion:report": "tsx verify-openai/check-ingestion/generate-report.ts --write",
    "openai:ingestion:report:check": "tsx verify-openai/check-ingestion/generate-report.ts --check",
    "openai:ingestion:finalize": "npm run openai:ingestion:normalize && npm run openai:ingestion:report",
    "openai:ingestion:verify": "npm run openai:ingestion:inspect:check && npm run openai:ingestion:normalize:check && npm run openai:ingestion:report:check",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "verify": "biome check . && npm run openai:conversion:verify && npm run openai:ingestion:verify && npm run typecheck && npm test",
    "check": "npm run verify && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "json-schema-to-typescript",
    "openai-typescript",
    "json-schema",
    "typescript",
    "openai typescript format",
    "chatgpt",
    "mcp",
    "model-context-protocol",
    "mcp-tools",
    "tool-calling",
    "function-calling",
    "structured-output",
    "tool-schema",
    "schema-converter"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.17",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
